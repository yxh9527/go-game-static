[1,0,0,[["cc.TextAsset",["_name","text"],1]],[[0,0,1,3]],[[0,"fish_shell","<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<title>捕鱼</title>\n<style>\n  html, body {\n    margin: 0;\n    width: 100%;\n    height: 100%;\n    background: #000;\n    overflow: hidden;\n  }\n  #game-wrap {\n    position: fixed;\n    left: 0;\n    top: 0;\n    right: 0;\n    bottom: 0;\n    z-index: 1;\n    overflow: hidden;\n  }\n  #game {\n    position: absolute;\n    left: 0;\n    top: 0;\n    width: 100%;\n    height: 100%;\n    border: 0;\n    background: #000;\n  }\n  #back {\n    position: fixed;\n    z-index: 2147483647;\n    left: 18px;\n    top: 26px;\n    transform: rotate(90deg);\n    width: 40px;\n    height: 40px;\n    min-width: 40px;\n    min-height: 40px;\n    max-width: 40px;\n    max-height: 40px;\n    padding: 0;\n    border: 0;\n    background: transparent url(\"data:image/png;base64,\") center / 100% 100% no-repeat;\n    opacity: 0.8;\n    touch-action: manipulation;\n    user-select: none;\n    -webkit-user-select: none;\n    -webkit-tap-highlight-color: transparent;\n    cursor: grab;\n  }\n  #back.solid { opacity: 1; }\n  #back.dragging { cursor: grabbing; }\n  #leave {\n    display: none;\n    position: fixed;\n    left: 0;\n    top: 0;\n    right: 0;\n    bottom: 0;\n    z-index: 2147483647;\n    align-items: center;\n    justify-content: center;\n    background: rgba(0, 0, 0, 0.45);\n  }\n  #leave.show { display: flex; }\n  #leave .box {\n    width: 280px;\n    padding: 22px 18px 16px;\n    border-radius: 20px;\n    background: rgba(18, 22, 32, 0.96);\n    color: #fff;\n    text-align: center;\n  }\n  #leave p {\n    margin: 0 0 18px;\n    font-size: 16px;\n  }\n  #leave .actions { display: flex; }\n  #leave .actions button {\n    flex: 1;\n    height: 40px;\n    margin: 0 6px;\n    border: 0;\n    border-radius: 8px;\n    font-size: 16px;\n  }\n  #leave-close { background: #3a4150; color: #fff; }\n  #leave-ok { background: #e0b15a; color: #1a1408; }\n</style>\n</head>\n<body>\n  <div id=\"game-wrap\"><iframe id=\"game\" allow=\"autoplay; fullscreen; clipboard-read; clipboard-write\" allowfullscreen></iframe></div>\n  <button id=\"back\" type=\"button\" aria-label=\"返回\"></button>\n  <div id=\"leave\">\n    <div class=\"box\">\n      <p>确认退出游戏？</p>\n      <div class=\"actions\">\n        <button id=\"leave-close\" type=\"button\">取消</button>\n        <button id=\"leave-ok\" type=\"button\">确认</button>\n      </div>\n    </div>\n  </div>\n<script>\n  var FISH_BOOT_URL = \"\";\n  var FISH_SHOW_BACK = true;\n  var FISH_NATIVE = true;\n  var HALL_HOSTS = { \"www.google.com\": 1, \"google.com\": 1, \"example.com\": 1, \"www.example.com\": 1, \"example.org\": 1, \"www.example.org\": 1 };\n  var hallLeaving = false;\n  var gameStarted = false;\n\n  function setFishGame(url) {\n    if (gameStarted) {\n      layoutGame();\n      return;\n    }\n    gameStarted = true;\n    if (url) document.getElementById(\"game\").src = url;\n    layoutGame();\n  }\n  window.setFishGame = setFishGame;\n\n  (function readQuery() {\n    try {\n      var q = new URLSearchParams(location.search);\n      var game = q.get(\"game\");\n      if (game) setFishGame(game);\n    } catch (e) {}\n  })();\n  if (FISH_BOOT_URL && !gameStarted) setFishGame(FISH_BOOT_URL);\n\n  function sendBack() {\n    try {\n      if (window.parent && window.parent !== window) {\n        window.parent.postMessage({ type: \"fish-back\" }, \"*\");\n      }\n    } catch (e) {}\n    if (!FISH_NATIVE) return;\n    try { location.href = \"fishback://back?type=back\"; } catch (e2) {}\n  }\n\n  function notifyBack() {\n    if (hallLeaving) return;\n    hallLeaving = true;\n    sendBack();\n  }\n\n  function askLeave() {\n    var panel = document.getElementById(\"leave\");\n    if (!panel || panel.className.indexOf(\"show\") >= 0) return;\n    panel.className = \"show\";\n  }\n\n  function hideLeave() {\n    var panel = document.getElementById(\"leave\");\n    if (panel) panel.className = \"\";\n  }\n\n  document.getElementById(\"leave-close\").addEventListener(\"click\", hideLeave);\n  document.getElementById(\"leave-ok\").addEventListener(\"click\", function () {\n    hideLeave();\n    notifyBack();\n  });\n\n  function isHallUrl(url) {\n    if (!url) return false;\n    var text = String(url).trim();\n    var match = text.match(/^[a-z][a-z0-9+.-]*:\\/\\/([^\\/?#]+)/i);\n    if (!match) return false;\n    var host = match[1];\n    var at = host.lastIndexOf(\"@\");\n    if (at >= 0) host = host.slice(at + 1);\n    var colon = host.indexOf(\":\");\n    if (colon >= 0) host = host.slice(0, colon);\n    return !!HALL_HOSTS[host.toLowerCase()];\n  }\n\n  function readGameHref() {\n    var frame = document.getElementById(\"game\");\n    if (!frame || !frame.contentWindow) return \"\";\n    try {\n      return frame.contentWindow.location.href || \"\";\n    } catch (e) {\n      return \"\";\n    }\n  }\n\n  function checkHallUrl(url) {\n    if (hallLeaving) return;\n    var href = url || readGameHref();\n    if (!isHallUrl(href)) return;\n    hallLeaving = true;\n    var frame = document.getElementById(\"game\");\n    if (frame) frame.src = \"about:blank\";\n    sendBack();\n  }\n\n  var layoutTries = 0;\n\n  function layoutGame() {\n    var game = document.getElementById(\"game\");\n    var w = window.innerWidth || document.documentElement.clientWidth || 0;\n    var h = window.innerHeight || document.documentElement.clientHeight || 0;\n    if (w < 2 || h < 2) {\n      if (layoutTries < 20) {\n        layoutTries += 1;\n        setTimeout(layoutGame, 50);\n      }\n      return;\n    }\n    layoutTries = 0;\n    var wrap = document.getElementById(\"game-wrap\");\n    if (wrap) {\n      wrap.style.right = \"auto\";\n      wrap.style.bottom = \"auto\";\n      wrap.style.left = \"0px\";\n      wrap.style.top = \"0px\";\n      wrap.style.width = w + \"px\";\n      wrap.style.height = h + \"px\";\n    }\n    game.style.left = \"0px\";\n    game.style.top = \"0px\";\n    game.style.width = \"100%\";\n    game.style.height = \"100%\";\n  }\n\n  window.addEventListener(\"resize\", layoutGame);\n  window.addEventListener(\"orientationchange\", layoutGame);\n  layoutGame();\n\n  var gameFrame = document.getElementById(\"game\");\n  gameFrame.addEventListener(\"load\", function () {\n    if (!gameStarted) return;\n    checkHallUrl(readGameHref());\n  });\n  window.addEventListener(\"message\", function (event) {\n    if (!event || !isHallUrl(event.origin)) return;\n    checkHallUrl(event.origin);\n  });\n\n  (function bindDrag() {\n    var btn = document.getElementById(\"back\");\n    if (!FISH_SHOW_BACK) {\n      if (btn && btn.parentNode) btn.parentNode.removeChild(btn);\n      return;\n    }\n    var dragging = false;\n    var moved = false;\n    var suppressClick = false;\n    var startX = 0;\n    var startY = 0;\n    var originL = 0;\n    var originT = 0;\n    var fadeTimer = 0;\n\n    function showSolid() {\n      if (fadeTimer) {\n        clearTimeout(fadeTimer);\n        fadeTimer = 0;\n      }\n      btn.classList.add(\"solid\");\n    }\n\n    function fadeLater() {\n      if (fadeTimer) clearTimeout(fadeTimer);\n      fadeTimer = setTimeout(function () {\n        fadeTimer = 0;\n        btn.classList.remove(\"solid\");\n      }, 2000);\n    }\n\n    function point(e) {\n      if (e.touches && e.touches.length) return e.touches[0];\n      if (e.changedTouches && e.changedTouches.length) return e.changedTouches[0];\n      return e;\n    }\n\n    function clamp(left, top) {\n      var maxL = Math.max(0, (window.innerWidth || 0) - btn.offsetWidth);\n      var maxT = Math.max(0, (window.innerHeight || 0) - btn.offsetHeight);\n      if (left < 0) left = 0;\n      if (top < 0) top = 0;\n      if (left > maxL) left = maxL;\n      if (top > maxT) top = maxT;\n      btn.style.left = left + \"px\";\n      btn.style.top = top + \"px\";\n    }\n\n    function onDown(e) {\n      if (e && e.button != null && e.button !== 0) return;\n      var p = point(e);\n      if (!p) return;\n      var rect = btn.getBoundingClientRect();\n      dragging = true;\n      moved = false;\n      suppressClick = false;\n      showSolid();\n      originL = rect.left;\n      originT = rect.top;\n      startX = p.clientX;\n      startY = p.clientY;\n    }\n\n    function onMove(e) {\n      if (!dragging) return;\n      var p = point(e);\n      if (!p) return;\n      var dx = p.clientX - startX;\n      var dy = p.clientY - startY;\n      if (Math.abs(dx) < 14 && Math.abs(dy) < 14) return;\n      if (!moved) {\n        moved = true;\n        btn.style.bottom = \"auto\";\n        btn.classList.add(\"dragging\");\n      }\n      clamp(originL + dx, originT + dy);\n      if (e.cancelable) e.preventDefault();\n    }\n\n    function onUp() {\n      if (!dragging) return;\n      dragging = false;\n      btn.classList.remove(\"dragging\");\n      if (moved) {\n        suppressClick = true;\n        moved = false;\n        fadeLater();\n        return;\n      }\n      askLeave();\n    }\n\n    function onCancel() {\n      if (!dragging) return;\n      dragging = false;\n      btn.classList.remove(\"dragging\");\n      if (moved) suppressClick = true;\n      moved = false;\n      fadeLater();\n    }\n\n    btn.addEventListener(\"click\", function () {\n      if (suppressClick || moved || dragging) {\n        suppressClick = false;\n        return;\n      }\n      askLeave();\n    });\n    btn.addEventListener(\"touchstart\", onDown, { passive: true });\n    btn.addEventListener(\"touchend\", onUp);\n    btn.addEventListener(\"touchcancel\", onCancel);\n    window.addEventListener(\"touchmove\", onMove, { passive: false });\n    window.addEventListener(\"touchend\", onUp);\n    window.addEventListener(\"touchcancel\", onCancel);\n    btn.addEventListener(\"mousedown\", onDown);\n    window.addEventListener(\"mousemove\", onMove);\n    window.addEventListener(\"mouseup\", onUp);\n  })();\n</script>\n</body>\n</html>\n"]],0,0,[],[],[]]